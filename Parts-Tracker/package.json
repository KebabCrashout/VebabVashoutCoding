{
  "name": "parts-tracker",
  "version": "1.1.0",
  "description": "Track project parts: images, prices, links, order status and totals",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/ensure-electron.js",
    "dist": "electron-builder --win && node scripts/build-updater.js",
    "dist:updater": "node scripts/build-updater.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0"
  },
  "build": {
    "appId": "com.vebabvashout.partstracker",
    "productName": "Parts Tracker",
    "files": [
      "main.js",
      "preload.js",
      "pricefinder.js",
      "renderer/**/*",
      "package.json",
      "!data/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Parts Tracker"
    },
    "portable": {
      "artifactName": "Parts-Tracker-${version}-portable.exe"
    }
  }
}
